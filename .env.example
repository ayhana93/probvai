# =============================================================================
# ПРОБВАЙ — променливи на средата
#
# Копирай този файл като `.env` и попълни стойностите.
#   cp .env.example .env
#
# Правило №2 от заданието: нула твърдо зашити стойности. Всяка цена, лимит и
# праг е тук. Правило №3: НИКОГА не слагай префикс NEXT_PUBLIC_ на ключ —
# всичко с този префикс влиза в браузъра и се чете от всеки.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# ПРИЛОЖЕНИЕ
# ─────────────────────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development

# Порт, на който слуша приложението.
PORT=3000

# Публичният адрес на приложението. Ползва се за връзки в имейлите и за
# callback адресите на OAuth.
APP_URL=http://localhost:3000

# Показва се в GET /api/health. В production го подавай като git SHA.
APP_VERSION=dev


# ─────────────────────────────────────────────────────────────────────────────
# БАЗА ДАННИ — четири връзки, четири различни роли
#
# Това не е излишно усложнение. Ако потребителското приложение бъде пробито,
# атакуващият получава DATABASE_URL_APP. С нея той физически не може да
# промени баланс на кредити, нито да прочете чужд ред или таблицата с
# плащанията. Проверката е в самата база, не в кода.
#
# Паролите се задават с `npm run db:roles` — скриптът ги вади от връзките
# по-долу и ги прилага на ролите.
# ─────────────────────────────────────────────────────────────────────────────

# Собственик на таблиците. Ползва се САМО от `prisma migrate`.
# В production не слагай тази променлива в контейнера на приложението —
# подавай я само когато пускаш миграции.
DATABASE_URL=postgresql://probvai_migrator:migrator_dev@localhost:5432/probvai

# Потребителското приложение. Row Level Security реже чуждите редове.
DATABASE_URL_APP=postgresql://app_user:app_user_dev@localhost:5432/probvai

# Вътрешни задачи: Auth.js, Stripe webhook-ове, работниците на pg-boss, cron.
DATABASE_URL_SYSTEM=postgresql://app_system:app_system_dev@localhost:5432/probvai

# Админ панелът (Фаза 7). Единствената роля с достъп до одитния лог.
DATABASE_URL_ADMIN=postgresql://app_admin:app_admin_dev@localhost:5432/probvai


# ─────────────────────────────────────────────────────────────────────────────
# АВТЕНТИКАЦИЯ (Auth.js v5) — Фаза 1
# ─────────────────────────────────────────────────────────────────────────────

# Публичният адрес, на който Auth.js връща потребителя след вход.
NEXTAUTH_URL=http://localhost:3000

# Тайна за подписване. Генерирай с: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple — https://developer.apple.com/account/resources/identifiers
APPLE_ID=
APPLE_SECRET=

# Facebook — https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# ФАЙЛОВЕ — Cloudflare R2 през S3 API — Фаза 1
# ─────────────────────────────────────────────────────────────────────────────

# ID-то на акаунта в Cloudflare. От него се сглобява адресът на API-то.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=probvai

# Незадължително. Ако е празно, се ползва
# https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# Попълва се само при S3-съвместимо хранилище, различно от R2 (MinIO при
# локална разработка например).
R2_ENDPOINT=

# Колко секунди е валиден подписаният адрес за изображение.
SIGNED_URL_TTL_SECONDS=900

# Максимален размер на качен файл в байтове (10 MB).
UPLOAD_MAX_BYTES=10485760

# Дългата страна на снимката се смалява до толкова пиксела при качване.
UPLOAD_MAX_DIMENSION=2048


# ─────────────────────────────────────────────────────────────────────────────
# AI ДОСТАВЧИЦИ — Фаза 2
#
# Тези ключове живеят САМО на сървъра. Ако попаднат в браузъра, някой ще
# изхарчи баланса ни за часове.
# ─────────────────────────────────────────────────────────────────────────────

# Кой доставчик работи: fashn_tryon_max | fashn_v16 | fal_image_apps_v2
TRYON_PROVIDER=fashn_tryon_max

# FASHN — https://app.fashn.ai/api
FASHN_API_KEY=

# fal.ai — резервен доставчик — https://fal.ai/dashboard/keys
FAL_API_KEY=

# Колко секунди работникът чака доставчика, преди да обяви провал.
GENERATION_TIMEOUT_SECONDS=120

# След колко секунди интерфейсът се отказва да чака и показва грешка.
GENERATION_CLIENT_TIMEOUT_SECONDS=90


# ─────────────────────────────────────────────────────────────────────────────
# ПЛАЩАНИЯ — Фаза 5
# ─────────────────────────────────────────────────────────────────────────────

# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Тайната на webhook endpoint-а. Без нея всеки може да си дава кредити.
STRIPE_WEBHOOK_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# ИМЕЙЛИ И SMS — Фаза 1
# ─────────────────────────────────────────────────────────────────────────────

# https://resend.com/api-keys
RESEND_API_KEY=

# Подателят на имейлите. Домейнът трябва да е потвърден в Resend.
RESEND_FROM=ПРОБВАЙ <здравей@probvai.bg>

# Twilio — праща SMS само при висок риск — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# ─────────────────────────────────────────────────────────────────────────────
# ПАРИ И ЛИМИТИ
#
# Тези числа са аварийните спирачки. Ако не са зададени, приложението
# отказва да тръгне — по-добре да не работи, отколкото да работи без таван.
# ─────────────────────────────────────────────────────────────────────────────

# ГЛАВНАТА СПИРАЧКА. Като сумата на себестойността за деня достигне тази
# стойност, всички генерации спират и получавам имейл.
# Без нея една дупка в защитата значи сметка от €3000 за една нощ.
MAX_DAILY_SPEND_USD=25

# При колко процента от тавана да получа предупредителен имейл.
DAILY_SPEND_ALERT_PCT=80

# Колко генерации може да пусне един потребител за денонощие.
MAX_GENERATIONS_PER_USER_PER_DAY=50

# Колко секунди трябва да минат между две заявки на един потребител.
GENERATION_COOLDOWN_SECONDS=15


# ─────────────────────────────────────────────────────────────────────────────
# КРЕДИТИ
# ─────────────────────────────────────────────────────────────────────────────

# Цена на един кредит в евро. Един кредит = една генерация.
CREDIT_PRICE_EUR=0.20

# Границите на еднократна покупка.
MIN_PURCHASE_CREDITS=25
MAX_PURCHASE_CREDITS=1000

# Безплатни кредити. Максимумът е 3 + 1 + 1 = 5.
FREE_CREDITS_SIGNUP=3
FREE_CREDITS_EMAIL_VERIFIED=1
FREE_CREDITS_PHONE_VERIFIED=1


# ─────────────────────────────────────────────────────────────────────────────
# ПОТВЪРЖДАВАНЕ НА ТЕЛЕФОН
# ─────────────────────────────────────────────────────────────────────────────

# Колко секунди е валиден кодът от SMS-а.
PHONE_CODE_TTL_SECONDS=600

# След колко грешни опита кодът се обезсилва.
PHONE_MAX_ATTEMPTS=5

# Колко секунди трябва да минат между два SMS-а към един потребител.
PHONE_RESEND_COOLDOWN_SECONDS=60

# Колко SMS-а най-много на денонощие на потребител. SMS-ите струват пари.
PHONE_MAX_SENDS_PER_DAY=5


# ─────────────────────────────────────────────────────────────────────────────
# РИСК — Фаза 6
# ─────────────────────────────────────────────────────────────────────────────

# 40 и нагоре: безплатните кредити чакат SMS потвърждение.
RISK_THRESHOLD_SMS=40

# 70 и нагоре: нула безплатни кредити.
# Потребителката НЕ вижда съобщение за блокиране — просто екрана за зареждане.
RISK_THRESHOLD_BLOCK=70


# ─────────────────────────────────────────────────────────────────────────────
# ЗАПАЗВАНЕ НА ДАННИ — Фаза 8
# ─────────────────────────────────────────────────────────────────────────────

# След колко дни неактивност се трият изображенията в R2.
# Акаунтът и кредитите остават.
INACTIVITY_DELETE_DAYS=90

# На кой ден се праща първото и второто предупреждение.
INACTIVITY_WARN_FIRST_DAYS=76
INACTIVITY_WARN_SECOND_DAYS=87


# ─────────────────────────────────────────────────────────────────────────────
# АДМИН И МОНИТОРИНГ — Фази 7 и 9
# ─────────────────────────────────────────────────────────────────────────────

# Кои имейли имат достъп до админ панела. Разделени със запетая.
ADMIN_EMAILS=

# Къде отиват аварийните известия (достигнат дневен таван, паднал доставчик).
ADMIN_ALERT_EMAIL=

# https://sentry.io — Settings → Projects → Client Keys (DSN)
SENTRY_DSN=
