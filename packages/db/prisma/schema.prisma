// ПРОБВАЙ — модел на данните.
//
// Конвенция: полетата в Prisma са camelCase, колоните в базата са snake_case.
// Причина: SQL-ът на политиките за Row Level Security се пише на ръка и
// snake_case го прави четим без кавички.
//
// ВАЖНО: `users.credits` е КЕШ. Истината е SUM(credit_ledger.delta).
// Двете трябва винаги да съвпадат — има тест, който го проверява.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Изброими типове
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum LedgerReason {
  SIGNUP
  EMAIL_VERIFY
  PHONE_VERIFY
  PURCHASE
  GENERATION
  REFUND
  ADMIN
}

enum GenStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  REFUNDED
}

// Полът се пита при регистрация и служи за две неща: приложението да говори
// правилно и предложенията за покупка да са за правилния човек. `OTHER` е
// задължително — списък от два реда изключва хора без причина.
enum Gender {
  MALE
  FEMALE
  OTHER
}

// От къде е дошла дрехата. Заради това поле името на магазина се показва
// в гардероба само когато го знаем наистина — при качена снимка нямаме
// откъде да знаем от кой магазин е дрехата.
enum GenSource {
  UPLOAD
  LINK
}

// Стиловите категории. Всяка визия се нарежда автоматично в една от тях —
// така Lookbook-ът се пълни без ръчна работа. Човекът може да я смени.
enum StyleCategory {
  BUSINESS
  STREETWEAR
  LUXURY
  SUMMER
  ELEGANT
  CUTE
  GYM
  WEDDING
  PARTY
  CASUAL
  DATE
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum MessageAuthor {
  USER
  ADMIN
}

// ---------------------------------------------------------------------------
// Потребител
// ---------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  // Auth.js изисква полетата да се казват точно `name`, `email`,
  // `emailVerified` и `image`. Колоната обаче е `email_verified_at`,
  // както е в заданието.
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified_at")
  image         String?

  phone           String?   @unique
  phoneVerifiedAt DateTime? @map("phone_verified_at")

  // ── Вход с парола ────────────────────────────────────────────────────────
  // Празно за хората, влезли с Google/Apple/Facebook — те нямат парола при
  // нас и не бива да имат. Колкото по-малко пароли пазим, толкова по-малко
  // има какво да изтече.
  //
  // Стойността е `scrypt$N$r$p$сол$ключ`, не самата парола. Дори пълно
  // копие на базата не дава на никого нечий вход.
  passwordHash String? @map("password_hash")

  // ── Възстановяване на забравена парола ───────────────────────────────────
  // Пази се КЛЮЧЪТ на въпроса, не текстът му — текстът може да се преведе
  // или преформулира, без записаните отговори да станат невалидни.
  securityQuestion String? @map("security_question")

  // Отговорът също е хеш. Той е втора парола и се пази като парола.
  securityAnswerHash String? @map("security_answer_hash")

  // Брояч на грешните отговори. Таен въпрос без ограничение на опитите е
  // задна врата — отговорите са къси и се налучкват.
  resetAttempts Int       @default(0) @map("reset_attempts")
  resetLockedAt DateTime? @map("reset_locked_at")

  // ── Профил ───────────────────────────────────────────────────────────────
  // Питат се при регистрация. Полето `name` остава за Auth.js — то идва от
  // Google/Apple и не е разделено на две.
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  gender    Gender?

  // Пази се ГОДИНАТА на раждане, не възрастта. Възраст, записана веднъж,
  // остава невярна завинаги; годината е вярна винаги. Формата пита за
  // възраст, защото така мисли човекът — превръщането е наша работа.
  birthYear Int? @map("birth_year")

  // Публичен гардероб значи, че визиите му МОГАТ да се публикуват в Lookbook.
  // По подразбиране НЕ. Публикуването на снимка с лице е решение, което се
  // взима нарочно, не се получава по невнимание.
  wardrobePublic Boolean @default(false) @map("wardrobe_public")

  // Докато е празно, показваме екрана за довършване на профила.
  profileCompletedAt DateTime? @map("profile_completed_at")

  // ── Напредък ─────────────────────────────────────────────────────────────
  // Точки опит: по една на изхарчен кредит. Пипат се само от core/tier.ts.
  xp Int @default(0)

  // Похарчено за кредити, в евроцентове. Цяло число нарочно — пари в
  // плаваща запетая се сумират до 199.99999 и прагът не се стига никога.
  lifetimeSpendCents Int @default(0) @map("lifetime_spend_cents")

  // Кеш на баланса. Пипа се САМО от packages/core/src/credits.ts.
  credits Int @default(0)

  // Пази от повторно раздаване на безплатни кредити.
  freeCreditsGiven Boolean @default(false) @map("free_credits_given")

  // Рискова оценка от Фаза 6. 0–39 нисък, 40–69 нужда от SMS, 70+ нула кредити.
  riskScore Int @default(0) @map("risk_score")

  status UserStatus @default(ACTIVE)

  // Ключ в R2 към снимката по подразбиране на потребителя.
  defaultPhotoKey String? @map("default_photo_key")

  // Нулира се при всяко влизане и при покупка. Брои 90-те дни неактивност.
  lastActiveAt DateTime @default(now()) @map("last_active_at")

  // Кога е изпратено последното предупреждение за изтриване (ден 76 / 87).
  deletionWarnedAt DateTime? @map("deletion_warned_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts           Account[]
  sessions           Session[]
  ledger             CreditLedger[]
  generations        Generation[]
  tickets            SupportTicket[]
  phoneVerifications PhoneVerification[]
  likes              LookLike[]
  saves              LookSave[]

  @@index([lastActiveAt])
  @@index([status])
  @@index([riskScore])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Auth.js — сесии в базата, не JWT
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Еднократни кодове за потвърждаване на телефон.
// Пази се само SHA-256 хеш на кода — ако някой прочете таблицата, не може
// да влезе с прочетеното.
model PhoneVerification {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // В международен формат: +359...
  phone    String
  codeHash String @map("code_hash")

  // Брой грешни опити. Над лимита кодът се обезсилва.
  attempts Int @default(0)

  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("phone_verifications")
}

// ---------------------------------------------------------------------------
// Кредити
// ---------------------------------------------------------------------------

// Всяка промяна на кредити е ред тук. Редовете НИКОГА не се трият и не се
// променят — само се добавят. Одитната следа трябва да е пълна.
model CreditLedger {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // Положително = добавени кредити, отрицателно = изхарчени.
  delta  Int
  reason LedgerReason

  // Към какво се отнася: generationId, Stripe session id, adminId...
  refId String? @map("ref_id")

  // Балансът СЛЕД операцията. Позволява проверка без сумиране на всичко.
  balance Int

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reason, createdAt])
  @@map("credit_ledger")
}

// ---------------------------------------------------------------------------
// Генерации
// ---------------------------------------------------------------------------

model Generation {
  id     String    @id @default(cuid())
  userId String    @map("user_id")
  status GenStatus @default(QUEUED)

  // Кой доставчик е използван — `fashn_tryon_max`, `fashn_v16`, `fal_image_apps_v2`.
  provider      String
  providerJobId String? @map("provider_job_id")

  // Ключове в R2.
  personKey  String  @map("person_key")
  garmentKey String  @map("garment_key")
  resultKey  String? @map("result_key")

  // Съотношение на кадъра — единствената настройка, достъпна за потребителя.
  aspectRatio String @default("auto") @map("aspect_ratio")

  // Безплатните генерации носят воден знак.
  watermarked Boolean @default(false)

  // Себестойност в USD. Сумата за деня се сравнява с MAX_DAILY_SPEND_USD.
  costUSD Decimal? @map("cost_usd") @db.Decimal(10, 4)

  // Качена снимка или линк към магазин.
  source GenSource @default(UPLOAD)

  // От кой магазин е дрехата. Има стойност САМО при `source = LINK` —
  // при качена снимка нямаме откъде да знаем от кой магазин е дрехата,
  // а измисленото име е по-лошо от липсващото.
  merchant String?

  // Адресът на продукта. Пази се, за да работи „Купи тази дреха" и по-късно.
  productUrl String? @map("product_url")

  // ── Стил ─────────────────────────────────────────────────────────────────
  // Слага се автоматично след успешна генерация. Човекът може да я смени;
  // тогава `categoryLocked` спира автоматиката да я върне обратно.
  category       StyleCategory?
  categoryLocked Boolean        @default(false) @map("category_locked")

  // Разпознат пол по снимката. Служи само за насочване на предложенията.
  personGender Gender? @map("person_gender")

  // ── Гардероб и Lookbook ──────────────────────────────────────────────────
  // Кога е свалена в галерията на телефона.
  savedAt DateTime? @map("saved_at")

  // Кога е публикувана в Lookbook. NULL значи „само моя".
  publishedAt DateTime? @map("published_at")

  // Кеш на броя харесвания. Истината е COUNT(look_likes) — има тест.
  likeCount Int @default(0) @map("like_count")

  errorCode String? @map("error_code")

  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes LookLike[]
  saves LookSave[]

  @@index([userId, createdAt])
  // Индексът за глобалния дневен таван — най-горещата заявка в системата.
  @@index([createdAt, status])
  @@index([status])
  // Lookbook: публикуваните, по категории.
  @@index([publishedAt, category])
  @@map("generations")
}

// ---------------------------------------------------------------------------
// Lookbook
// ---------------------------------------------------------------------------
//
// Публична галерия и нищо повече. Няма профили, няма последователи, няма
// чат и няма коментари. Затова тук няма таблица за коментари и няма таблица
// за връзки между хора — двете неща, които превръщат галерията в социална
// мрежа и носят със себе си модерация, доклади и тормоз.

// Едно харесване на човек на визия. Съставният ключ го налага — не се
// разчита на кода да проверява преди да пише.
model LookLike {
  userId       String   @map("user_id")
  generationId String   @map("generation_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@id([userId, generationId])
  @@index([generationId])
  @@map("look_likes")
}

// „Запази" — чужда визия, сложена настрани за после. Не е копие на снимката,
// само отметка.
model LookSave {
  userId       String   @map("user_id")
  generationId String   @map("generation_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@id([userId, generationId])
  @@index([userId, createdAt])
  @@map("look_saves")
}

// ---------------------------------------------------------------------------
// Защита от злоупотреба
// ---------------------------------------------------------------------------

model DeviceFingerprint {
  id   String @id @default(cuid())
  hash String @unique

  // Всички потребители, влизали от това устройство.
  userIds String[] @map("user_ids")

  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  @@map("device_fingerprints")
}

// Пазим само SHA-256 хешове — необратимо, GDPR-съвместимо.
// Служи да не даваме безплатни кредити при повторна регистрация.
model DeletedIdentity {
  id         String  @id @default(cuid())
  emailHash  String  @unique @map("email_hash")
  phoneHash  String? @unique @map("phone_hash")
  deviceHash String? @map("device_hash")

  deletedAt DateTime @default(now()) @map("deleted_at")

  @@map("deleted_identities")
}

// ---------------------------------------------------------------------------
// Плащания
// ---------------------------------------------------------------------------

// Идемпотентност на Stripe webhook-овете. Ключът е Stripe event.id.
model ProcessedWebhook {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_webhooks")
}

// ---------------------------------------------------------------------------
// Админ
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id       String @id @default(cuid())
  adminId  String @map("admin_id")
  action   String
  targetId String @map("target_id")

  // Задължителна писмена причина. Без нея действието не се извършва.
  reason  String
  payload Json   @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([targetId])
  @@map("admin_audit_log")
}

// ---------------------------------------------------------------------------
// Поддръжка
// ---------------------------------------------------------------------------

model SupportTicket {
  id      String       @id @default(cuid())
  userId  String       @map("user_id")
  subject String
  status  TicketStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id       String        @id @default(cuid())
  ticketId String        @map("ticket_id")
  author   MessageAuthor
  body     String

  // Вътрешна бележка — вижда се само в админ панела.
  internal Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
