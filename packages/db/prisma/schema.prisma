// ПРОБВАЙ — модел на данните.
//
// Конвенция: полетата в Prisma са camelCase, колоните в базата са snake_case.
// Причина: SQL-ът на политиките за Row Level Security се пише на ръка и
// snake_case го прави четим без кавички.
//
// ВАЖНО: `users.credits` е КЕШ. Истината е SUM(credit_ledger.delta).
// Двете трябва винаги да съвпадат — има тест, който го проверява.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Изброими типове
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum LedgerReason {
  SIGNUP
  EMAIL_VERIFY
  PHONE_VERIFY
  PURCHASE
  GENERATION
  REFUND
  ADMIN
}

enum GenStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  REFUNDED
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum MessageAuthor {
  USER
  ADMIN
}

// ---------------------------------------------------------------------------
// Потребител
// ---------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  // Auth.js изисква полетата да се казват точно `name`, `email`,
  // `emailVerified` и `image`. Колоната обаче е `email_verified_at`,
  // както е в заданието.
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified_at")
  image         String?

  phone           String?   @unique
  phoneVerifiedAt DateTime? @map("phone_verified_at")

  // Кеш на баланса. Пипа се САМО от packages/core/src/credits.ts.
  credits Int @default(0)

  // Пази от повторно раздаване на безплатни кредити.
  freeCreditsGiven Boolean @default(false) @map("free_credits_given")

  // Рискова оценка от Фаза 6. 0–39 нисък, 40–69 нужда от SMS, 70+ нула кредити.
  riskScore Int @default(0) @map("risk_score")

  status UserStatus @default(ACTIVE)

  // Ключ в R2 към снимката по подразбиране на потребителката.
  defaultPhotoKey String? @map("default_photo_key")

  // Нулира се при всяко влизане и при покупка. Брои 90-те дни неактивност.
  lastActiveAt DateTime @default(now()) @map("last_active_at")

  // Кога е изпратено последното предупреждение за изтриване (ден 76 / 87).
  deletionWarnedAt DateTime? @map("deletion_warned_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts    Account[]
  sessions    Session[]
  ledger      CreditLedger[]
  generations Generation[]
  tickets     SupportTicket[]

  @@index([lastActiveAt])
  @@index([status])
  @@index([riskScore])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Auth.js — сесии в базата, не JWT
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Кредити
// ---------------------------------------------------------------------------

// Всяка промяна на кредити е ред тук. Редовете НИКОГА не се трият и не се
// променят — само се добавят. Одитната следа трябва да е пълна.
model CreditLedger {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // Положително = добавени кредити, отрицателно = изхарчени.
  delta  Int
  reason LedgerReason

  // Към какво се отнася: generationId, Stripe session id, adminId...
  refId String? @map("ref_id")

  // Балансът СЛЕД операцията. Позволява проверка без сумиране на всичко.
  balance Int

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reason, createdAt])
  @@map("credit_ledger")
}

// ---------------------------------------------------------------------------
// Генерации
// ---------------------------------------------------------------------------

model Generation {
  id     String    @id @default(cuid())
  userId String    @map("user_id")
  status GenStatus @default(QUEUED)

  // Кой доставчик е използван — `fashn_tryon_max`, `fashn_v16`, `fal_image_apps_v2`.
  provider      String
  providerJobId String? @map("provider_job_id")

  // Ключове в R2.
  personKey  String  @map("person_key")
  garmentKey String  @map("garment_key")
  resultKey  String? @map("result_key")

  // Съотношение на кадъра — единствената настройка, достъпна за потребителката.
  aspectRatio String @default("auto") @map("aspect_ratio")

  // Безплатните генерации носят воден знак.
  watermarked Boolean @default(false)

  // Себестойност в USD. Сумата за деня се сравнява с MAX_DAILY_SPEND_USD.
  costUSD Decimal? @map("cost_usd") @db.Decimal(10, 4)

  // От кой магазин е дрехата, ако е дошла през линк.
  merchant String?

  errorCode String? @map("error_code")

  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  // Индексът за глобалния дневен таван — най-горещата заявка в системата.
  @@index([createdAt, status])
  @@index([status])
  @@map("generations")
}

// ---------------------------------------------------------------------------
// Защита от злоупотреба
// ---------------------------------------------------------------------------

model DeviceFingerprint {
  id   String @id @default(cuid())
  hash String @unique

  // Всички потребители, влизали от това устройство.
  userIds String[] @map("user_ids")

  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  @@map("device_fingerprints")
}

// Пазим само SHA-256 хешове — необратимо, GDPR-съвместимо.
// Служи да не даваме безплатни кредити при повторна регистрация.
model DeletedIdentity {
  id         String  @id @default(cuid())
  emailHash  String  @unique @map("email_hash")
  phoneHash  String? @unique @map("phone_hash")
  deviceHash String? @map("device_hash")

  deletedAt DateTime @default(now()) @map("deleted_at")

  @@map("deleted_identities")
}

// ---------------------------------------------------------------------------
// Плащания
// ---------------------------------------------------------------------------

// Идемпотентност на Stripe webhook-овете. Ключът е Stripe event.id.
model ProcessedWebhook {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_webhooks")
}

// ---------------------------------------------------------------------------
// Админ
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id       String @id @default(cuid())
  adminId  String @map("admin_id")
  action   String
  targetId String @map("target_id")

  // Задължителна писмена причина. Без нея действието не се извършва.
  reason  String
  payload Json   @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([targetId])
  @@map("admin_audit_log")
}

// ---------------------------------------------------------------------------
// Поддръжка
// ---------------------------------------------------------------------------

model SupportTicket {
  id      String       @id @default(cuid())
  userId  String       @map("user_id")
  subject String
  status  TicketStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id       String        @id @default(cuid())
  ticketId String        @map("ticket_id")
  author   MessageAuthor
  body     String

  // Вътрешна бележка — вижда се само в админ панела.
  internal Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
