{
  "name": "probvai",
  "version": "0.1.0",
  "private": true,
  "description": "ПРОБВАЙ — виртуална проба на дрехи",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @probvai/web",
    "build": "npm run prisma:generate && npm run build --workspace @probvai/web",
    "build:clean": "npm run prisma:generate && node scripts/build-clean.mjs",
    "start": "node scripts/start-standalone.mjs",
    "worker": "tsx scripts/worker.ts",
    "images": "node scripts/prepare-images.mjs",
    "lint": "npm run lint --workspace @probvai/web",
    "typecheck": "tsc --noEmit -p packages/db/tsconfig.json && tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "db:setup": "npm run prisma:deploy && npm run db:roles",
    "db:roles": "tsx scripts/db-roles.ts",
    "db:reset": "prisma migrate reset --schema packages/db/prisma/schema.prisma"
  },
  "//overrides": "Next 15 носи закачени версии на postcss и sharp с известни уязвимости (libvips CVE-2026-33327 и др.). Вдигаме ги за целия проект. Маха се, когато Next ги вдигне сам.",
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.4",
    "pg": "^8.22.0",
    "prisma": "^6.19.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
